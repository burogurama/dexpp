# ===== call graph =====

class CallEdge:
    """Handle to one call-graph edge (one call site -> one possible target)."""

    @property
    def caller_node(self) -> int: ...
    @property
    def callee_node(self) -> int: ...
    @property
    def caller(self) -> CallNode:
        """The calling node (same as graph.nodes[caller_node])."""
    @property
    def callee(self) -> CallNode:
        """The called node (same as graph.nodes[callee_node])."""
    @property
    def kind(self) -> InvokeKind: ...
    @property
    def code_offset(self) -> int: ...
    @property
    def origin(self) -> EdgeOrigin: ...
    @property
    def via_override(self) -> bool:
        """Deprecated: use `origin`. True iff origin == EdgeOrigin.CHA_OVERRIDE.

        Note `not via_override` no longer identifies declared edges — test
        origin == EdgeOrigin.DECLARED instead.
        """
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class CallNode:
    """Handle to one call-graph node (a method, defined or external)."""

    @property
    def index(self) -> int: ...
    @property
    def id(self) -> MethodId: ...
    @property
    def resolved(self) -> bool: ...
    @property
    def outgoing(self) -> list[int]:
        """Indices into CallGraph.edges of this node's call sites; see out_edges."""
    @property
    def incoming(self) -> list[int]:
        """Indices into CallGraph.edges of the calls into this node; see in_edges."""
    @property
    def out_edges(self) -> CallEdgeView: ...
    @property
    def in_edges(self) -> CallEdgeView: ...
    @property
    def method(self) -> Optional[Method]:
        """The Method for a resolved node; None for external methods."""
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class CallNodeView(Sequence[CallNode]):
    """Read-only, zero-copy sequence of call-graph nodes."""

    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, index: int) -> CallNode: ...
    @overload
    def __getitem__(self, index: slice) -> list[CallNode]: ...
    def __iter__(self) -> Iterator[CallNode]: ...

class CallEdgeView(Sequence[CallEdge]):
    """Read-only, zero-copy sequence of call-graph edges."""

    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, index: int) -> CallEdge: ...
    @overload
    def __getitem__(self, index: slice) -> list[CallEdge]: ...
    def __iter__(self) -> Iterator[CallEdge]: ...
    def where(
        self, *, origin: Optional[EdgeOrigin] = None, kind: Optional[InvokeKind] = None
    ) -> CallEdgeView:
        """The edges of this view matching every given filter, selected in C++.

        Class-hierarchy fan-out can make a graph tens of millions of edges, so
        filter here rather than in a Python loop, e.g.
        graph.edges.where(origin=EdgeOrigin.DECLARED) for one edge per call site.
        """

class CallGraph:
    @property
    def nodes(self) -> CallNodeView: ...
    @property
    def edges(self) -> CallEdgeView: ...
    def find(self, id: MethodId) -> Optional[CallNode]: ...
    def method_for(self, node: CallNode) -> Optional[Method]: ...
    @property
    def empty(self) -> bool: ...

# ===== class hierarchy =====

class ClassHierarchy:
    def supertypes(self, descriptor: str) -> list[str]: ...
    def subclasses(self, descriptor: str) -> list[str]: ...
    def implementers(self, descriptor: str) -> list[str]: ...
    def all_supertypes(self, descriptor: str) -> list[str]: ...
    def all_descendants(self, descriptor: str) -> list[str]: ...
    def is_subtype_of(self, sub: str, super: str) -> bool: ...
    def is_loaded(self, descriptor: str) -> bool: ...
    def is_interface(self, descriptor: str) -> bool: ...
    @property
    def empty(self) -> bool: ...

