    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, index: int) -> BasicBlock: ...
    @overload
    def __getitem__(self, index: slice) -> list[BasicBlock]: ...
    def __iter__(self) -> Iterator[BasicBlock]: ...

class Cfg:
