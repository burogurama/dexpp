# ===== analysis context =====

class AnalysisContext:
    @staticmethod
    def from_dex(path: str) -> AnalysisContext: ...
    @staticmethod
    def from_dex_files(paths: list[str]) -> AnalysisContext: ...
    @staticmethod
    def from_apk(path: str, threads: int = 0) -> AnalysisContext:
        """Load every classes*.dex of an APK, in multidex order.

        threads: 0 = automatic, 1 = load on the calling thread only. Extra threads
        are only used when at least 3 DEX entries are deflate-compressed.
        """
    @property
    def classes(self) -> list[Class]: ...
    @property
    def strings(self) -> list[str]: ...
    def find_class(self, descriptor: str) -> Optional[Class]: ...
    @property
    def call_graph(self) -> CallGraph: ...
    @property
    def class_hierarchy(self) -> ClassHierarchy: ...
    @property
    def xrefs(self) -> Xrefs: ...

