    def proto(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class FieldId:
    def __init__(self, class_descriptor: str, name: str, type: str) -> None: ...
    @property
    def class_descriptor(self) -> str: ...
    @property
    def name(self) -> str: ...
    @property
    def type(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
